{"version": 2, "width": 100, "height": 30, "title": "Git Bare Repository — Git Bash Demo (Windows)", "env": {"TERM": "xterm-256color", "SHELL": "bash"}}
[0.85, "o", "# ============================================================\r\n"]
[1.5, "o", "#  Git Bare Repository — Demo (Git Bash)\r\n"]
[2.15, "o", "#  Ein Terminal, Ordner wechseln: bare / my_project / user_git\r\n"]
[2.8, "o", "# ============================================================\r\n"]
[3.0, "o", "\r\n"]
[3.85, "o", "# Was ist ein Bare Repo?\r\n"]
[4.5, "o", "#  - Normales Repo: Quelldateien + .git-Ordner\r\n"]
[5.15, "o", "#  - Bare Repo: nur Git-Datenbank (objects, refs, HEAD) — kein Arbeitsverzeichnis\r\n"]
[5.8, "o", "#  - Lokales Aequivalent zu GitHub/GitLab — empfängt Push, liefert Clone\r\n"]
[6.0, "o", "\r\n"]
[6.85, "o", "# ------------------------------------------------------------\r\n"]
[7.5, "o", "# 0) Git vorhanden? Version prüfen\r\n"]
[8.15, "o", "# ------------------------------------------------------------\r\n"]
